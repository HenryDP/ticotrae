{
  "manifest_version": 3,
  "name": "TicoTrae Importador",
  "version": "1.1",
  "description": "Captura productos de Amazon y eBay dejándolo fijo en tu navegador como un panel lateral.",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "host_permissions": [
    "https://*.amazon.com/*",
    "https://*.amazon.es/*",
    "https://*.ebay.com/*"
  ],
  "action": {
    "default_title": "Abrir panel de TicoTrae"
  },
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.amazon.com/*",
        "https://*.amazon.es/*",
        "https://*.ebay.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self';"
  }
}
