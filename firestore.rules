rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. Red de seguridad global (Bloquea todo por defecto)
    match /{document=**} {
      allow read, write: if false;
    }

    // ==========================================
    // FUNCIONES REUTILIZABLES
    // ==========================================
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    function isSignedIn() { return request.auth != null; }
    
    // Centralizamos tu rol de administrador para mayor seguridad
    function isAdmin() { 
      return isSignedIn() && ('email' in request.auth.token) && request.auth.token.email == 'duranhenry1981@gmail.com'; 
    }
    
    // Verifica si el usuario actual es el creador original del documento
    function isOwner(data) { 
      return isSignedIn() && data.ownerId == request.auth.uid; 
    }

    // ==========================================
    // REGLAS POR COLECCIÓN
    // ==========================================

    // --- PRODUCTOS ---
    match /productos/{productoId} {
      allow read: if true; // Cualquier cliente puede ver el catálogo

      // Creación: Autenticado
      allow create: if isSignedIn();

      // Actualización: Solo el creador o el Admin. Evita secuestro de productos.
      allow update: if isSignedIn() 
                    && (isOwner(existing()) || isAdmin())
                    && (incoming().keys().hasAny(['ownerId']) == false || incoming().ownerId == existing().ownerId);

      allow delete: if isAdmin() || (isSignedIn() && isOwner(existing()));
    }

    // --- AJUSTES DE LA PWA (Configuración, T.C., Márgenes) ---
    match /settings/{docId} {
      allow read: if true; // Público para que la PWA calcule precios
      allow write: if isAdmin(); // SEGURIDAD CERRADA: Solo el administrador edita
    }

    // --- COMENTARIOS / RESEÑAS ---
    match /comentarios/{comentarioId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().autorId == request.auth.uid;
      allow update: if isSignedIn() && existing().autorId == request.auth.uid;
      allow delete: if isAdmin() || (isSignedIn() && existing().autorId == request.auth.uid);
    }

    // --- PERFILES DE USUARIO ---
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }

    // --- SUSCRIPTORES DEL NEWSLETTER ---
    match /newsletter_subscribers/{docId} {
      allow create: if true; // Abierto para que los clientes se registren
      allow read, delete: if isAdmin(); // SEGURIDAD CERRADA: Solo el administrador gestiona los correos
    }
  }
}